; Swell widget colors for REAPER on Linux — the tarball build has no GTK
; theming, so this file IS the dark mode for every dialog, menu, menubar,
; listview, combobox and the whole Preferences window. Without it they render
; in libSwell's stock light grey (#B3B3B3) next to a dark arrange view.
;
; Values follow the paRt theme's own .ReaperTheme so the chrome matches the
; arrange view rather than approximating it:
;   col_arrangebg    #1f1f1f   darkest ground
;   col_tr1_bg       #262626   panel bodies
;   col_mixerbg      #242424   chassis
;   col_main_text2   #e6e6e6   body text
;   col_cursor       #71d2ae   mint accent, reused here for selection
; Note paRt's own colour keys for menus/lists are LIGHT (#cfcfcf) because it
; draws that chrome from images, which Swell widgets cannot use — so those
; roles are darkened here to match the rest of the UI rather than copied.
;
; paRt ships no libSwell theme (almost no theme does — Linux is a minority
; target), so this is hand-authored.
;
; default_font_face must name a font that actually exists on Fedora:
; Liberation Sans is stock and metric-compatible with Arial.
default_font_face Liberation Sans
default_font_size 13
menubar_height 17
menubar_font_size 12
menubar_spacing_width 8
menubar_margin_width 6
scrollbar_width 14
scrollbar_min_thumb_height 4
combo_height 20
_3dface #242424
_3dshadow #161616
_3dhilight #161616
_3ddkshadow #161616
button_bg #1f1f1f ; defaults to _3dface
button_text #e6e6e6
button_text_disabled #6b6b6b
button_shadow #161616
button_hilight #161616
checkbox_text #e6e6e6
checkbox_text_disabled #7a7a7a
checkbox_fg #d0d0d0
checkbox_inter #71d2ae
checkbox_bg #1a1a1a
scrollbar #242424
scrollbar_fg #5c5c5c
scrollbar_bg #1f1f1f
edit_cursor #71d2ae
edit_bg #161616
edit_bg_disabled #1f1f1f
edit_text #e6e6e6
edit_text_disabled #7a7a7a
edit_bg_sel #71d2ae
edit_text_sel #000000
edit_hilight #161616 ; defaults to _3dhilight
edit_shadow #161616 ; defaults to _3dshadow
info_bk #1f1f1f
info_text #e6e6e6
menu_bg #1f1f1f ; defaults to _3dface
menu_shadow #1c1c1c ; defaults to _3dshadow
menu_hilight #2e2e2e ; defaults to _3dhilight
menu_text #e6e6e6 ; defaults to button_text
menu_text_disabled #777777
menu_bg_sel #71d2ae ; defaults to menu_text
menu_text_sel #000000 ; defaults to menu_bg
menu_scroll #242424
menu_scroll_arrow #d0d0d0 ; defaults to _3dshadow
menu_submenu_arrow #d0d0d0
menubar_bg #242424 ; defaults to menu_bg
menubar_text #e6e6e6 ; defaults to menu_text
menubar_text_disabled #777777
menubar_bg_sel #71d2ae ; defaults to menu_bg_sel
menubar_text_sel #000000 ; defaults to menu_text_sel
trackbar_track #161616
trackbar_mark #161616
trackbar_knob #71d2ae
progress #71d2ae
label_text #e6e6e6 ; defaults to button_text
label_text_disabled #7a7a7a ; defaults to button_text_disabled
combo_text #e6e6e6 ; defaults to button_text
combo_text_disabled #777777 ; defaults to button_text_disabled
combo_bg #1a1a1a
combo_bg2 #1a1a1a
combo_shadow #1a1a1a
combo_hilight #1a1a1a ; defaults to _3dhilight
combo_arrow #d0d0d0
combo_arrow_press #71d2ae ; defaults to _3dhilight
listview_bg #1f1f1f
listview_bg_sel #71d2ae
listview_text #e6e6e6
listview_text_sel #000000
listview_bg_sel_inactive #3a3a3a
listview_text_sel_inactive #e6e6e6
listview_grid #242424 ; defaults to _3dhilight
listview_hdr_arrow #d0d0d0
listview_hdr_shadow #242424 ; defaults to _3dshadow
listview_hdr_hilight #242424 ; defaults to _3dhilight
listview_hdr_bg #242424 ; defaults to _3dface
listview_hdr_text #e6e6e6 ; defaults to button_text
treeview_text #e6e6e6
treeview_bg #1f1f1f
treeview_bg_sel #71d2ae
treeview_text_sel #000000
treeview_bg_sel_inactive #3a3a3a
treeview_text_sel_inactive #e6e6e6
treeview_arrow #d0d0d0
tab_shadow #1f1f1f
tab_hilight #1f1f1f
tab_text #e6e6e6
focusrect #e6e6e6
group_text #e6e6e6
group_shadow #303030 ; defaults to _3dshadow
group_hilight #2c2c2c ; defaults to _3dhilight
focus_hilight #71d2ae
