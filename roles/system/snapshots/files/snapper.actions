# fedora-init (snapshots role) — snapper pre/post snapshots around every
# dnf5 transaction, via libdnf5-plugin-actions (Fedora 44 ships plugin
# 1.4.1). Format: five colon-separated fields per action line —
# callback:package_filter:direction:options:command. Unescaped spaces
# split the command into argv items; backslash-escaped spaces stay inside
# one argument; ${...} substitution happens BEFORE unescaping. There is
# no shell unless the command itself is `sh -c`, so quotes below are
# literal argv bytes (sh syntax on the sh lines, python syntax on the
# python line). tmp.* variables persist between hooks by printing
# `tmp.name=value` to stdout; printing the bare name unsets it. Errors
# are logged by dnf but never abort the transaction (the plugin's
# raise_error option defaults to 0) — a failed snapshot must not block
# an update.
#
# This is upstream dnf5's canonical "emulate the DNF4 snapper plugin"
# example (actions.8) with two deliberate deltas:
#   1. `-c number` on both snapper create calls — upstream's example
#      accumulates snapshots forever; number-cleanup (snapper-cleanup.timer
#      + the NUMBER_LIMIT the role seeds) only prunes snapshots created
#      with the "number" cleanup algorithm.
#   2. An rpmdb WAL checkpoint before the post snapshot — rpm's sqlite
#      runs in WAL mode, and a snapshot taken with unflushed WAL frames
#      makes `snapper undochange` revert the files while rpm still
#      reports the packages installed (the SysGuides Fedora 44 finding).
#      python3 stdlib only, no sqlite3 CLI dependency; best-effort by the
#      raise_error default above.

# Snapshot description = the command line that ran the transaction.
pre_transaction::::/usr/bin/sh -c echo\ "tmp.snapper_descr=$(ps\ -o\ command\ --no-headers\ -p\ '${pid}')"

# Pre snapshot; the number is kept to pair the post snapshot with.
pre_transaction::::/usr/bin/sh -c echo\ "tmp.snapper_pre_number=$(snapper\ create\ -c\ number\ -t\ pre\ -p\ -d\ '${tmp.snapper_descr}')"

# Flush rpm's sqlite WAL so the post snapshot's rpmdb is self-contained.
post_transaction::::/usr/bin/python3 -c import\ sqlite3;c=sqlite3.connect('/usr/lib/sysimage/rpm/rpmdb.sqlite',timeout=3);c.execute('PRAGMA\ busy_timeout=3000');c.execute('PRAGMA\ wal_checkpoint(TRUNCATE)');c.close()

# Post snapshot, paired to the pre; the trailing echos clear the tmp.*
# variables.
post_transaction::::/usr/bin/sh -c [\ -n\ "${tmp.snapper_pre_number}"\ ]\ &&\ snapper\ create\ -c\ number\ -t\ post\ --pre-number\ "${tmp.snapper_pre_number}"\ -d\ "${tmp.snapper_descr}"\ ;\ echo\ tmp.snapper_pre_number\ ;\ echo\ tmp.snapper_descr
