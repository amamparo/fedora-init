# Managed by fedora-init (roles/ai/ollama) — llm_local_context and ollama_igpu live
# in site.yml; edit them there, not here.
#
# Upstream's unit (what ollama.com/install.sh writes) with the environment
# this machine wants. Every knob ollama has is an environment variable read
# by `ollama serve`; nothing is configured anywhere else.
[Unit]
Description=Ollama Service

[Service]
ExecStart=/usr/local/bin/ollama serve
User=ollama
Group=ollama
Restart=always
RestartSec=3
# Loopback only: litellm sits in front, and nothing else on the LAN gets an
# unauthenticated model server. This IS ollama's default; spelled out so a
# future "expose it" edit has one obvious line to change.
Environment=OLLAMA_HOST=127.0.0.1:11434
# Explicit rather than the $HOME/.ollama/models default, so the path in
# roles/ai/ollama/tasks/main.yml and this one can never drift.
Environment=OLLAMA_MODELS=/var/lib/ollama/models
# The context window every model loads with unless a request says
# otherwise. ollama's own default is VRAM-tiered and lands on 4096 for CPU
# inference (and 32768 with the iGPU) — 4k truncates an agent's tool
# schemas; upstream's context-length doc says 64k+ for coding agents. This
# is the memory knob: KV cache scales linearly with it (halved by q8_0
# below). Setting it explicitly also turns off ollama's shrink-on-OOM
# fallback: a context that doesn't fit fails the load instead of
# silently loading smaller. Values above a model's trained context are
# clamped with a journal warning. Shared with the opencode role via
# llm_local_context in site.yml.
Environment=OLLAMA_CONTEXT_LENGTH={{ llm_local_context }}
# Keep a model resident 30 min after its last request (default 5m). The
# default model is ~19 GB and reloads in seconds-to-tens-of-seconds, so
# 5m means a cold start on every second agent turn; -1 would pin it in
# RAM forever. 30m is the compromise for a laptop.
Environment=OLLAMA_KEEP_ALIVE=30m
# K/V cache quantised to 8-bit: about half the KV memory at the same
# context, and q8_0 is the quality-safe step (q4_0 is the lossy one). A
# quantised V cache needs flash attention: ollama's `auto` turns it on for
# both the CPU and Vulkan paths (verified in ml/device.go and llama.cpp's
# context setup), so the explicit 1 is belt-and-braces — never set it to 0
# with q8_0, that is a hard model-load failure, not a fallback.
Environment=OLLAMA_FLASH_ATTENTION=1
Environment=OLLAMA_KV_CACHE_TYPE=q8_0
# No ollama.com cloud. This also stops the model-recommendations fetch the
# daemon makes at every start and every ~4 hours — a request SIGNED with
# this install's persistent ed25519 key (server/cloud_proxy.go), i.e. a
# per-machine beacon on every boot. Flip to 0 if you ever want `ollama
# signin` / cloud models.
Environment=OLLAMA_NO_CLOUD=1
# Whether the Intel iGPU may be used through Vulkan. Vulkan itself is on by
# default since 0.30, but ollama drops every integrated GPU it discovers
# unless this is set ("dropping integrated GPU; to enable, set
# OLLAMA_IGPU_ENABLE=1" in the journal); 0 is an explicit deny. Declared
# in site.yml (ollama_igpu) with the benchmark that decided the default.
Environment=OLLAMA_IGPU_ENABLE={{ 1 if ollama_igpu | bool else 0 }}
# CPU threads for whatever runs on the CPU (everything with the iGPU off;
# the un-offloaded remainder with it on). ollama has no thread setting of
# its own, but it hands its environment to llama-server, whose --threads
# has this env binding. Without it llama.cpp's auto-detection picks 2 on
# this 4 P-core + 4 E-core, no-SMT chip (its SMT-sibling skip halves the
# P-core count) — measured: 4.5 -> 6.3 tokens/s on an 8B model. 4 = the
# P-cores; 8 pulls in the E-cores and collapses to 0.8 tokens/s (lockstep
# threading waits on the slowest core). A per-request num_thread still
# wins (ollama then passes -t explicitly).
Environment=LLAMA_ARG_THREADS=4
# Hardening. /usr/local (binary + backends) is read-only under strict;
# the state dir is the daemon's HOME and the model store. No
# PrivateDevices: Vulkan needs /dev/dri.
ProtectSystem=strict
ReadWritePaths=/var/lib/ollama
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
