# fedora-init — installed to ~/.zshrc
export PATH="$HOME/.local/bin:$PATH"  # user-installed CLIs (claude, herdr, etc.); zsh doesn't get this from /etc/profile
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="robbyrussell"
plugins=(git)

source "$ZSH/oh-my-zsh.sh"

# fzf: Ctrl+R fuzzy history, Ctrl+T file picker, Alt+C fuzzy cd. Fedora's
# rpm installs these bindings but deliberately leaves them off (its
# README.Fedora); completion already auto-loads from zsh site-functions —
# never source that half by hand. Guarded like mise below (cli_tools role).
[[ -r /usr/share/fzf/shell/key-bindings.zsh ]] && source /usr/share/fzf/shell/key-bindings.zsh

# zoxide: `z <fuzzy-name>` jumps to any dir you've visited. The rpm ships
# no profile.d hook — this eval is the only wiring (cli_tools role).
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

# mise: runtime versions (node/python/java) — hooks cd to apply per-project
# pins. Guarded so the shell works before the mise role has run.
command -v mise >/dev/null && eval "$(mise activate zsh)"

# neovim: the editor (neovim role). EDITOR/VISUAL reach git commit, crontab
# -e, Ctrl-X Ctrl-E and Claude Code's editor key; this overrides Fedora's
# nano default (/etc/profile.d/nano-default-editor.sh runs before this
# file). alias vim=nvim also catches `vi`, because vim-enhanced's
# /etc/profile.d/vim.sh already aliases vi=vim and zsh expands aliases
# recursively; `\vim` still reaches real Vim (cli_tools keeps it installed).
if command -v nvim >/dev/null; then
  export EDITOR=nvim VISUAL=nvim
  alias vim=nvim
fi
