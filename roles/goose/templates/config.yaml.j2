# Managed by fedora-init (roles/goose) — llm_default_model lives in site.yml;
# edit it there, not here. Goose never writes this file: your own choices
# (the desktop's Settings, /model, /mode, the telemetry answer) go to
# ~/.config/goose/config.yaml and take precedence over everything here.
#
# Provider: the local litellm proxy (roles/litellm), keyed — goose's own
# virtual key (LITELLM_API_KEY) lives in ~/.config/goose/secrets.yaml, kept
# current by the goose role. GOOSE_MODEL is a litellm route: ollama/<tag>
# for a local model, anthropic/<model id> for Claude (once the Anthropic
# key is seeded).
GOOSE_PROVIDER: litellm
GOOSE_MODEL: {{ llm_default_model }}
# Mandatory twice over: it is what makes the desktop count litellm as a
# configured provider (LITELLM_HOST set OR a key stored — the host alone
# passes that check; the key itself is read from secrets.yaml), and
# without it the built-in fallback host is upstream's cloud, not localhost.
LITELLM_HOST: http://127.0.0.1:4000
# Off, and recorded — an unrecorded choice makes the first launch (and
# the first `goose session`) open a consent prompt.
GOOSE_TELEMETRY_ENABLED: false
# Secrets in ~/.config/goose/secrets.yaml (0600) instead of the login
# keyring: deterministic, so the role can seed the litellm virtual key
# (LITELLM_API_KEY) there — and the login keyring on this machine is
# blank-password anyway (login_keyring role), so the file loses nothing.
# Honoured from this layer (goose reads it from the merged config).
GOOSE_DISABLE_KEYRING: true
